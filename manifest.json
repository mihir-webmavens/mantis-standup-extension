{
  "manifest_version": 3,
  "name": "Mantis Quick Standup",
  "version": "1.3.1",
  "description": "Add a standup to standup.webmavens.dev directly from a Mantis ticket page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mantis Quick Standup: button style",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://standup.webmavens.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://projects.webmavens.dev/*"],
      "js": ["button-styles.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
