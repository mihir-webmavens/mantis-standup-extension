{
  "manifest_version": 3,
  "name": "Mantis Quick Standup",
  "version": "1.9.0",
  "description": "Add standups and EODs to standup.webmavens.dev from Mantis, plus MantisAI chat through your local Claude CLI.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mantis Quick Standup",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["notifications", "nativeMessaging"],
  "host_permissions": ["https://standup.webmavens.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-standup": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "Open Add Standup and focus Planned Action"
    },
    "open-eod": {
      "suggested_key": { "default": "Ctrl+Shift+E" },
      "description": "Open the EOD list"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://projects.webmavens.dev/*"],
      "css": ["mantis-header.css"],
      "js": ["header-layout.js", "mantis-header.js", "themes.js", "mantis-theme.js", "mantis-ai.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://projects.webmavens.dev/*"],
      "js": ["button-styles.js", "content.js", "playground-events.js", "playground.js"],
      "run_at": "document_idle"
    }
  ]
}
