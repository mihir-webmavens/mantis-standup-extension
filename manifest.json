{
  "manifest_version": 3,
  "name": "Mantis Quick Standup",
  "version": "1.5.0",
  "description": "Add a standup to standup.webmavens.dev directly from a Mantis ticket page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mantis Quick Standup",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["notifications"],
  "host_permissions": ["https://standup.webmavens.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-standup": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "Open Add Standup and focus Planned Action"
    },
    "open-eod": {
      "suggested_key": { "default": "Ctrl+Shift+E" },
      "description": "Open the EOD list"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://projects.webmavens.dev/*"],
      "js": ["button-styles.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
